PORT=4000
DATABASE_URL=postgresql://spendio:spendio@localhost:5433/spendio

TZ=Asia/Jakarta

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Parent cookie domain when web and API are sibling subdomains. Required for
# the web middleware to see the session cookie in production.
# COOKIE_DOMAIN=.example.com

# Email: console | resend | smtp (production must not use console)
EMAIL_TRANSPORT=console

# Required by resend and smtp transports
# EMAIL_FROM=Spendio <no-reply@example.com>

# Resend (EMAIL_TRANSPORT=resend)
# RESEND_API_KEY=

# SMTP (EMAIL_TRANSPORT=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
