NODE_ENV=production
PORT=4000
TZ=Asia/Jakarta

# Postgres from compose.prod.yaml (bound to 127.0.0.1 only)
DATABASE_URL=postgresql://spendio:CHANGE_ME@127.0.0.1:5432/spendio

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public API origin, must match the nginx server_name and match the scheme used by clients
BETTER_AUTH_URL=https://api.spendio.farriiedd.dev

# Public web origin; comma-separated if you have more than one (e.g. preview domains)
WEB_ORIGIN=https://spendio.farriiedd.dev

# Email: resend | smtp | console | none
# console prints verification/reset links to the systemd journal, which is enough
# to get the deployment working before a real provider is configured.
EMAIL_TRANSPORT=console
# EMAIL_FROM=Spendio <no-reply@example.com>
# RESEND_API_KEY=

# SMTP alternative (EMAIL_TRANSPORT=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Gmail SMTP (personal account + App Password, quickest setup)
# EMAIL_TRANSPORT=smtp
# EMAIL_FROM=Spendio <your.address@gmail.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
