{
  "name": "@spendio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@spendio/shared": "*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.13",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
